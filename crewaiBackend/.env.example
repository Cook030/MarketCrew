# Copy to .env in crewaiBackend. Never commit actual credentials.
LLM_TYPE=openai
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Embeddings can use a different OpenAI-compatible provider.
# An empty EMBEDDING_API_KEY falls back to OPENAI_API_KEY.
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Optional alternative chat providers; embeddings remain configured above.
ONEAPI_API_BASE=http://localhost:3000/v1
ONEAPI_API_KEY=
ONEAPI_CHAT_MODEL=qwen-max
OLLAMA_API_BASE=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=llama3.1:latest

# Set to enable optional web research alongside project materials.
SERPER_API_KEY=
PORT=8012
